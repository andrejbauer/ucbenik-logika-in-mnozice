%% Jezik
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage[slovene]{babel}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Stran
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage[
  paperwidth  = 155mm,
  paperheight = 235mm,
  textwidth   = 108mm,
  textheight  = 513pt,   % 38 vrstic po 13.5pt
  inner       = 21mm,
  top         = 24mm,
  includehead,
  headheight  = \lmnEnota,
  headsep     = \lmnEnota,
  footskip    = \lmnDvojnaEnota
]{geometry}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Matematika (amsmath pred unicode-math!)
