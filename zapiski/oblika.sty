\ProvidesPackage{oblika}[2026/09/30 Oblika ucbenika Logika in mnozice]

% Moznost `osnutek' doda v vznozje datum razlicice.
\newif\iflmnOsnutek\lmnOsnutekfalse
\DeclareOption{osnutek}{\lmnOsnutektrue}
\ProcessOptions\relax

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Nastavljive konstante
%%
%% Format: 155 x 235 mm (evropski ustreznik 6" x 9").
%% Stavek:  108 x 513pt = 38 vrstic po 13.5pt.
%% Stopnja: 10pt, razmik vrstic 13.5pt.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newlength{\lmnEnota}        \setlength{\lmnEnota}{13.5pt}
\newlength{\lmnPolEnota}     \setlength{\lmnPolEnota}{6.75pt}
\newlength{\lmnDvojnaEnota}  \setlength{\lmnDvojnaEnota}{27pt}

\newlength{\lmnDebelinaCrte} \setlength{\lmnDebelinaCrte}{2.5pt}

\newcommand{\lmnStopnjaStevilkePoglavja}{48} % stopnja stevilke poglavja
\newcommand{\lmnStopnjaNaslovaPoglavja}{20}   % stopnja naslova poglavja

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Jezik
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage[slovene]{babel}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Stran
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage[
  paperwidth  = 155mm,
  paperheight = 235mm,
  textwidth   = 108mm,
  textheight  = 513pt,   % 38 vrstic po 13.5pt
  inner       = 21mm,
  top         = 24mm,
  includehead,
  headheight  = \lmnEnota,
  headsep     = \lmnEnota,
  footskip    = \lmnDvojnaEnota
]{geometry}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Matematika (amsmath pred unicode-math!)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{amsmath}
\RequirePackage{amsthm}
\RequirePackage{mathtools}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Pisave
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{fontspec}
\RequirePackage{unicode-math}

\setmainfont{Libertinus Serif}[
  Ligatures = TeX,
  Numbers   = OldStyle
]
\setsansfont{Libertinus Sans}[Ligatures = TeX]
\setmonofont{Libertinus Mono}[Scale = MatchLowercase]
\setmathfont{Libertinus Math}
% Libertinus Math nima znaka U+22BB (ekskluzivna disjunkcija).
\setmathfont{STIX Two Math}[range={"22BB}]

% Naslovna razlicica za velike stopnje
\newfontfamily\lmnNaslovnaPisava{Libertinus Serif Display}[Ligatures = TeX]

% Kapitelke in verzalne stevke za tekoce naslove in oznake
\newfontfamily\lmnKapitelke{Libertinus Serif}[
  Ligatures = TeX,
  Letters   = SmallCaps,
  Numbers   = Lining
]
\newcommand{\lmnVerzalke}{\addfontfeature{Numbers=Lining}}

% Pisava vizualne podobe UL -- samo za platnice in naslovnico, ne za stavek.
\newfontfamily\lmnUniverzaSans{Univerza Sans}[Ligatures = TeX]
\newfontfamily\lmnUniverzaSansTanka{Univerza Sans Light}[Ligatures = TeX]

\RequirePackage[
  protrusion = true,
  expansion  = true,
  final
]{microtype}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Barve
%%
%% ULrdeca je barva CGP Univerze v Ljubljani (Pantone 1797, RAL 3028).
%% To je edina barva v knjigi.  Nosijo jo crte ob dogovornih okoljih in
%% stevilka poglavja; besedila ne barvamo.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{xcolor}
\definecolor{ULrdeca}{HTML}{E03127}
\definecolor{ULantracit}{HTML}{58595B}
\definecolor{ULsiva}{HTML}{A7A8AA}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Navpicni ritem
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\linespread{1.125} % 12pt -> 13.5pt

% Strog navpicni ritem: strani koncamo, kjer se koncajo, namesto da bi jih
% raztegovali do roba.
\raggedbottom

\setlength{\parindent}{1.5em}
\setlength{\parskip}{0pt}

\setlength{\abovedisplayskip}{\lmnPolEnota}
\setlength{\belowdisplayskip}{\lmnPolEnota}
\setlength{\abovedisplayshortskip}{0pt}
\setlength{\belowdisplayshortskip}{\lmnPolEnota}

\RequirePackage{enumitem}
\setlist{nosep, topsep=\lmnPolEnota, itemsep=0pt, parsep=0pt}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Izreki
%%
%% Trdilna okolja: telo v kurzivi.  Dogovorna okolja: telo pokoncno.
%% Oznaka v barvi poudarka, brez okvirjev, crt in podlag.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Uokvirjena so okolja, ki jih student isce nazaj: trditve in dogovori.
%% Barvi sta iz CGP UL -- rdeca za dogovore, antracit za trditve -- in
%% nosita zelo blago podlago.  Zgled, opomba in vaja ostanejo neuokvirjeni,
%% dokaz prav tako.

\newlength{\lmnDebelinaOkvira} \setlength{\lmnDebelinaOkvira}{0.6pt}
\newcommand{\lmnGostotaPodlage}{5} % odstotki

\newtheoremstyle{lmnLezeceTeloVOkviru}
  {0pt}{0pt}                 % razmik prispeva mdframed od zunaj
  {\itshape}{0pt}
  {\bfseries\lmnVerzalke}{.}
  {0.5em}{}

\newtheoremstyle{lmnPokoncnoTeloVOkviru}
  {0pt}{0pt}
  {\upshape}{0pt}
  {\bfseries\lmnVerzalke}{.}
  {0.5em}{}

\newtheoremstyle{lmnPokoncnoTelo}
  {\lmnEnota}{\lmnEnota}
  {\upshape}{0pt}
  {\bfseries\lmnVerzalke}{.}
  {0.5em}{}

\RequirePackage[framemethod=default]{mdframed}

\mdfdefinestyle{lmnOkvirTrditve}{
  linewidth         = \lmnDebelinaOkvira,
  linecolor         = ULantracit,
  backgroundcolor   = ULantracit!\lmnGostotaPodlage,
  innerleftmargin   = 0.8em,
  innerrightmargin  = 0.8em,
  innertopmargin    = \lmnPolEnota,
  innerbottommargin = \lmnPolEnota,
  skipabove         = \lmnEnota,
  skipbelow         = \lmnEnota
}

\mdfdefinestyle{lmnOkvirDogovora}{
  linewidth         = \lmnDebelinaOkvira,
  linecolor         = ULrdeca,
  backgroundcolor   = ULrdeca!\lmnGostotaPodlage,
  innerleftmargin   = 0.8em,
  innerrightmargin  = 0.8em,
  innertopmargin    = \lmnPolEnota,
  innerbottommargin = \lmnPolEnota,
  skipabove         = \lmnEnota,
  skipbelow         = \lmnEnota
}

\theoremstyle{lmnLezeceTeloVOkviru}
\newmdtheoremenv[style=lmnOkvirTrditve]{izrek}{Izrek}[chapter]
\newmdtheoremenv[style=lmnOkvirTrditve]{lema}[izrek]{Lema}
\newmdtheoremenv[style=lmnOkvirTrditve]{izjava}[izrek]{Izjava}
\newmdtheoremenv[style=lmnOkvirTrditve]{trditev}[izrek]{Trditev}
\newmdtheoremenv[style=lmnOkvirTrditve]{posledica}[izrek]{Posledica}
\newmdtheoremenv[style=lmnOkvirTrditve]{hipoteza}[izrek]{Hipoteza}

\theoremstyle{lmnPokoncnoTeloVOkviru}
\newmdtheoremenv[style=lmnOkvirDogovora]{definicija}[izrek]{Definicija}
\newmdtheoremenv[style=lmnOkvirDogovora]{aksiom}[izrek]{Aksiom}
\newmdtheoremenv[style=lmnOkvirDogovora]{pravilo}[izrek]{Pravilo}

\theoremstyle{lmnPokoncnoTelo}
\newtheorem{zgled}[izrek]{Zgled}
\newtheorem{opomba}[izrek]{Opomba}
\newtheorem{vaja}[izrek]{Vaja}

\renewcommand{\qedsymbol}{\ensuremath{\mdlgwhtsquare}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Naslovi poglavij in razdelkov
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage[explicit]{titlesec}

% Stevilka poglavja v pisavi UL, naslov v Libertinusu.
\titleformat{\chapter}[display]
  {\normalfont\raggedright}
  {\lmnNaslovnaPisava\fontsize{\lmnStopnjaStevilkePoglavja}{\lmnStopnjaStevilkePoglavja}%
   \selectfont\color{ULrdeca}\lmnVerzalke\thechapter}
  {\lmnEnota}
  {\lmnNaslovnaPisava\fontsize{\lmnStopnjaNaslovaPoglavja}{\lmnStopnjaNaslovaPoglavja}\selectfont #1}

% Poglavje se zacne priblizno tretjino strani navzdol (8 enot = 108pt).
\titlespacing*{\chapter}{0pt}{108pt}{\lmnDvojnaEnota}

\titleformat{\section}[hang]
  {\normalfont\large\bfseries\raggedright}
  {\lmnVerzalke\thesection}{0.75em}{#1}
\titlespacing*{\section}{0pt}{\lmnDvojnaEnota}{\lmnPolEnota}

\titleformat{\subsection}[hang]
  {\normalfont\bfseries\raggedright}
  {\lmnVerzalke\thesubsection}{0.75em}{#1}
\titlespacing*{\subsection}{0pt}{\lmnEnota}{0pt}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Tekoci naslovi
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{fancyhdr}

\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\ #1}}

\fancypagestyle{oblika}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
  \fancyhead[LE]{\lmnKapitelke\small\thepage\qquad\nouppercase{\leftmark}}%
  \fancyhead[RO]{\lmnKapitelke\small\nouppercase{\rightmark}\qquad\thepage}%
  \iflmnOsnutek\fancyfoot[C]{\lmnKapitelke\scriptsize[osnutek \today]}\fi
}

\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
  \iflmnOsnutek\fancyfoot[C]{\lmnKapitelke\scriptsize[osnutek \today]}\fi
}

% Prazne strani, ki nastanejo pri \cleardoublepage, naj bodo res prazne.
\RequirePackage{emptypage}

\pagestyle{oblika}

