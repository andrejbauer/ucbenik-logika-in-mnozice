\newlength{\lmnEnota}        \setlength{\lmnEnota}{13.5pt}
\newlength{\lmnPolEnota}     \setlength{\lmnPolEnota}{6.75pt}
\newlength{\lmnDvojnaEnota}  \setlength{\lmnDvojnaEnota}{27pt}

\newcommand{\lmnStopnjaStevilkePoglavja}{48} % stopnja stevilke poglavja
\newcommand{\lmnStopnjaNaslovaPoglavja}{20}   % stopnja naslova poglavja

