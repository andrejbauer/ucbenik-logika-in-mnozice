%% To je edina barva v knjigi.  Nosijo jo crte ob dogovornih okoljih in
%% stevilka poglavja; besedila ne barvamo.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{xcolor}
\definecolor{ULrdeca}{HTML}{E03127}
\definecolor{ULantracit}{HTML}{58595B}
\definecolor{ULsiva}{HTML}{A7A8AA}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Navpicni ritem
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\linespread{1.125} % 12pt -> 13.5pt

% Strog navpicni ritem: strani koncamo, kjer se koncajo, namesto da bi jih
% raztegovali do roba.
\raggedbottom

\setlength{\parindent}{1.5em}
\setlength{\parskip}{0pt}

\setlength{\abovedisplayskip}{\lmnPolEnota}
\setlength{\belowdisplayskip}{\lmnPolEnota}
\setlength{\abovedisplayshortskip}{0pt}
\setlength{\belowdisplayshortskip}{\lmnPolEnota}

\RequirePackage{enumitem}
\setlist{nosep, topsep=\lmnPolEnota, itemsep=0pt, parsep=0pt}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Izreki
%%
%% Trdilna okolja: telo v kurzivi.  Dogovorna okolja: telo pokoncno.
%% Oznaka v barvi poudarka, brez okvirjev, crt in podlag.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Brez okvirjev, crt, podlag in barve.  Okolja locita oznaka in lega
%% telesa: lezece pri trdilnih, pokoncno pri ostalih.  Barvo nosi samo
%% stevilka poglavja.

\newtheoremstyle{lmnLezeceTelo}
  {\lmnEnota}{\lmnEnota}     % razmik zgoraj / spodaj
  {\itshape}{0pt}            % telo / zamik
  {\bfseries\lmnVerzalke}{.} % oznaka / locilo
  {0.5em}{}                  % razmik za oznako / oblika

\newtheoremstyle{lmnPokoncnoTelo}
  {\lmnEnota}{\lmnEnota}
  {\upshape}{0pt}
  {\bfseries\lmnVerzalke}{.}
  {0.5em}{}

\theoremstyle{lmnLezeceTelo}
\newtheorem{izrek}{Izrek}[chapter]
\newtheorem{lema}[izrek]{Lema}
\newtheorem{izjava}[izrek]{Izjava}
\newtheorem{trditev}[izrek]{Trditev}
\newtheorem{posledica}[izrek]{Posledica}
\newtheorem{hipoteza}[izrek]{Hipoteza}

\theoremstyle{lmnPokoncnoTelo}
\newtheorem{definicija}[izrek]{Definicija}
\newtheorem{aksiom}[izrek]{Aksiom}
\newtheorem{pravilo}[izrek]{Pravilo}
\newtheorem{zgled}[izrek]{Zgled}
\newtheorem{opomba}[izrek]{Opomba}
\newtheorem{vaja}[izrek]{Vaja}

\renewcommand{\qedsymbol}{\ensuremath{\mdlgwhtsquare}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Naslovna stran
%%
%% Edina stran v knjigi, ki jo ureja CGP UL: pisava Univerza Sans in
%% rdeca v polni jakosti.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Naslov na naslovnici je lahko drugacen od naslova knjige (kazalo,
% tekoci naslovi, metapodatki PDF uporabljajo \title).
\newcommand{\lmnNaslovNaPlatnici}{\@title}
\newcommand{\lmnStopnjaNaslovnice}{80}
\newcommand{\lmnRazmikNaslovnice}{84}

\newcommand{\lmnUstanova}{Univerza v Ljubljani}
\newcommand{\lmnClanica}{Fakulteta za matematiko in fiziko}

\newcommand{\lmnNaslovnaStran}{%
  \begin{titlepage}%
  \thispagestyle{empty}%
  \raggedright\color{white}\setlength{\parindent}{0pt}%
  % Polna rdeca podlaga cez celo stran.  CGP: na temnih podlagah je vse
  % enobarvno in nikoli rdece, zato je tipografija tukaj bela.
  \noindent\begin{tikzpicture}[remember picture, overlay]
    \fill[ULrdeca] (current page.south west) rectangle (current page.north east);
  \end{tikzpicture}\par
  % Naslov stoji na zgornjem robu stavka, ustanova na spodnjem; razmerje
  % dolocajo robovi strani, ne izbrana stevilka.
  \vspace*{0pt}%
  {\lmnNaslovnaPisava\bfseries
   \fontsize{\lmnStopnjaNaslovnice}{\lmnRazmikNaslovnice}\selectfont
   \hyphenpenalty=10000 \exhyphenpenalty=10000
   \lmnNaslovNaPlatnici\par}%
  \vspace{\lmnDvojnaEnota}%
  {\lmnUniverzaSans\fontsize{13}{\lmnEnota}\selectfont
   \renewcommand{\and}{\quad\textbar\quad}%
   \@author\par}%
  \vfill
  \end{titlepage}%
  \lmnHrbtnaStran
}

%% Hrbtna stran naslovnice: kolofon in dovoljenje za uporabo.
\newcommand{\lmnHrbtnaStran}{%
  \thispagestyle{empty}%
  \null\vfill
  {\raggedright\footnotesize
   \textcopyright\ \the\year\ \lmnAvtorji\par
   \vspace{\lmnEnota}
   Gradivo je namenjeno študiju pri predmetu Logika in množice.
   Uporabljate ga smete za lasten študij.  Razmnoževanje, objavljanje,
   javno priobčevanje in predelava brez pisnega dovoljenja avtorjev niso
   dovoljeni.\par
   \vspace{\lmnEnota}
   \lmnUstanova, \lmnClanica\par
   \iflmnOsnutek Osnutek z dne \today.\par\fi
  }%
  \clearpage
}

\newcommand{\lmnAvtorji}{Andrej Bauer in Davorin Lešnik}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Naslovi poglavij in razdelkov
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage[explicit]{titlesec}

% Stevilka poglavja v pisavi UL, naslov v Libertinusu.
\titleformat{\chapter}[display]
  {\normalfont\raggedright}
  {\lmnNaslovnaPisava\fontsize{\lmnStopnjaStevilkePoglavja}{\lmnStopnjaStevilkePoglavja}%
   \selectfont\color{ULrdeca}\lmnVerzalke\thechapter}
  {\lmnEnota}
  {\lmnNaslovnaPisava\fontsize{\lmnStopnjaNaslovaPoglavja}{\lmnStopnjaNaslovaPoglavja}\selectfont #1}

% Poglavje se zacne priblizno tretjino strani navzdol (8 enot = 108pt).
\titlespacing*{\chapter}{0pt}{108pt}{\lmnDvojnaEnota}

\titleformat{\section}[hang]
  {\normalfont\large\bfseries\raggedright}
  {\lmnVerzalke\thesection}{0.75em}{#1}
\titlespacing*{\section}{0pt}{\lmnDvojnaEnota}{\lmnPolEnota}

\titleformat{\subsection}[hang]
  {\normalfont\bfseries\raggedright}
  {\lmnVerzalke\thesubsection}{0.75em}{#1}
\titlespacing*{\subsection}{0pt}{\lmnEnota}{0pt}

