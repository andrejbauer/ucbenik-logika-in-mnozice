\RequirePackage{amsmath}
\RequirePackage{amsthm}
\RequirePackage{mathtools}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Pisave
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{fontspec}
\RequirePackage{unicode-math}

\setmainfont{Libertinus Serif}[
  Ligatures = TeX,
  Numbers   = OldStyle
]
\setsansfont{Libertinus Sans}[Ligatures = TeX]
\setmonofont{Libertinus Mono}[Scale = MatchLowercase]
\setmathfont{Libertinus Math}
% Libertinus Math nima znaka U+22BB (ekskluzivna disjunkcija).
\setmathfont{STIX Two Math}[range={"22BB}]

% Naslovna razlicica za velike stopnje
\newfontfamily\lmnNaslovnaPisava{Libertinus Serif Display}[
  Ligatures = TeX,
  BoldFont  = LibertinusSerif-Bold.otf   % Display nima krepkega reza
]

% Kapitelke in verzalne stevke za tekoce naslove in oznake
\newfontfamily\lmnKapitelke{Libertinus Serif}[
  Ligatures = TeX,
  Letters   = SmallCaps,
  Numbers   = Lining
]
\newcommand{\lmnVerzalke}{\addfontfeature{Numbers=Lining}}

% Pisava vizualne podobe UL -- samo za platnice in naslovnico, ne za stavek.
\newfontfamily\lmnUniverzaSans{Univerza Sans}[Ligatures = TeX]
\newfontfamily\lmnUniverzaSansTanka{Univerza Sans Light}[Ligatures = TeX]

\RequirePackage[
  protrusion = true,
  expansion  = true,
  final
]{microtype}

