%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Naslov na naslovnici je lahko drugacen od naslova knjige (kazalo,
% tekoci naslovi, metapodatki PDF uporabljajo \title).
\newcommand{\lmnNaslovNaPlatnici}{\@title}
% Naslov je v eni vrstici. Razmik je razdalja med osnovnicama naslova in
% avtorjev.
\newcommand{\lmnStopnjaNaslovnice}{36}
\newlength{\lmnRazmikNaslovnice}  \setlength{\lmnRazmikNaslovnice}{\lmnDvojnaEnota}
% Prazen prostor nad verzalkami naslova in pod osnovnico avtorjev.
\newlength{\lmnZracnostPasuZgoraj}  \setlength{\lmnZracnostPasuZgoraj}{2.4cm}
\newlength{\lmnZracnostPasuSpodaj}  \setlength{\lmnZracnostPasuSpodaj}{2cm}

\newcommand{\lmnUstanova}{Univerza v Ljubljani}
\newcommand{\lmnClanica}{Fakulteta za matematiko in fiziko}

% Zid formul
\newcommand{\lmnFormuleZidu}{cover-formulas}
\newcommand{\lmnStopnjaZidu}{8.5}
\newcommand{\lmnRazmikZidu}{11.3}
\newcommand{\lmnPresledekZidu}{0.5em plus 0.5em minus 0.1em}
\newcommand{\lmnPorezZidu}{3mm}
\newcommand{\lmnSemeZidu}{1}
\colorlet{lmnBarvaZidu}{white}
\colorlet{lmnPodlagaZidu}{ULrdeca}
\colorlet{lmnBarvaNaslova}{white}

% Beli rob okoli plosce.
\newlength{\lmnRobNaslovnice}  \setlength{\lmnRobNaslovnice}{2mm}
% Sredisce pasu z naslovom, merjeno od vrha strani, v delezu visine strani.
\newcommand{\lmnPolozajNaslova}{0.40}

% Vse naslednje izracuna \lmnNaslovnaStran:
% - razmik vrstic zidu, pri katerem je visina plosce celo stevilo vrstic;
% - visino nad osnovnico, na kateri zgornji in spodnji rob plosce rezeta
%   vrstice, ter visino verzalk zidu in naslova;
% - zadnjo vrstico zidu nad pasom z naslovom (vrstica 0 je tista, ki jo
%   reze zgornji rob plosce) in razdaljo od nje do prve vrstice pod pasom
%   v vrsticah;
% - razdaljo od osnovnice zidu nad pasom do vrha verzalk naslova in
%   globino osnovnice naslova pod vrhom plosce.
\newlength{\lmnRazmikZiduNaPlosci}
\newlength{\lmnRezZidu}
\newlength{\lmnVerzalkeZidu}
\newlength{\lmnVerzalkeNaslova}
\newcount\lmnZadnjaVrsticaNadPasom
\newcount\lmnVrsticPasu
\newlength{\lmnOdmikNaslova}
\newlength{\lmnOsnovnicaNaslova}
\newsavebox{\lmnZidZgoraj}
\newsavebox{\lmnZidSpodaj}
\newsavebox{\lmnSkatlaNaslova}
\newsavebox{\lmnSkatlaAvtorjev}

\ExplSyntaxOn
\seq_new:N \l__lmn_zid_seq
\seq_new:N \l__lmn_zid_izpostavljene_seq
\int_new:N \l__lmn_zid_izpostavljena_int

% \F{...} doda formulo zidu, \F*{...} pa izpostavljeno formulo.
\cs_new_protected:Npn \__lmn_zid_dodaj:
  {
    \peek_charcode_remove:NTF *
      { \seq_put_right:Nn \l__lmn_zid_izpostavljene_seq }
      { \seq_put_right:Nn \l__lmn_zid_seq }
  }

% Polozaj #1-te izpostavljene formule: enakomerno med 40 in 65 odstotki
% premesanega zaporedja, kar je vidni del zidu pod naslovom.
\cs_new:Npn \__lmn_zid_polozaj:n #1
  {
    \int_eval:n
      {
        \seq_count:N \l__lmn_zid_seq
        * ( 40 + 25 * ( #1 - 1 )
              / \int_max:nn { 1 } { \seq_count:N \l__lmn_zid_izpostavljene_seq - 1 } )
        / 100
      }
  }

\cs_new_protected:Npn \__lmn_zid:
  {
    \sys_gset_rand_seed:n { \lmnSemeZidu }
    \seq_shuffle:N \l__lmn_zid_seq
    \int_zero:N \l__lmn_zid_izpostavljena_int
    % Izpostavljena formula je nedeljiva in z obeh strani vezana na sosedi,
    % zato ne zacne ne konca vrstice in je porez ne odreze.
    \seq_map_indexed_inline:Nn \l__lmn_zid_seq
      {
        $##2$
        \bool_lazy_and:nnTF
          {
            \int_compare_p:nNn
              { \l__lmn_zid_izpostavljena_int } < { \seq_count:N \l__lmn_zid_izpostavljene_seq }
          }
          {
            \int_compare_p:nNn
              { ##1 } = { \__lmn_zid_polozaj:n { \l__lmn_zid_izpostavljena_int + 1 } }
          }
          {
            \int_incr:N \l__lmn_zid_izpostavljena_int
            \nobreak \hskip \lmnPresledekZidu \scan_stop:
            \mbox
              {
                $ \seq_item:Nn \l__lmn_zid_izpostavljene_seq
                    { \l__lmn_zid_izpostavljena_int } $
              }
            \nobreak \hskip \lmnPresledekZidu \scan_stop:
          }
          { \hskip \lmnPresledekZidu \scan_stop: }
      }
  }

\NewDocumentCommand{\lmnZbirajFormule}{}{ \cs_set_eq:NN \F \__lmn_zid_dodaj: }
\NewDocumentCommand{\lmnZid}{}{ \__lmn_zid: }
\ExplSyntaxOff

\newcommand{\lmnNaslovnaStran}{%
  \begin{titlepage}%
  \thispagestyle{lmnNaslovnica}%
  \lmnZbirajFormule
  \input{\lmnFormuleZidu}%
  \setlength{\lmnRazmikZiduNaPlosci}{\dimexpr
    (\paperheight - 2\lmnRobNaslovnice)
    / \fpeval{round((\paperheight - 2 * \lmnRobNaslovnice) / (\lmnRazmikZidu pt))}
    \relax}%
  {\fontsize{\lmnStopnjaZidu}{\lmnRazmikZidu}\selectfont
   \global\lmnRezZidu = 0.5ex
   \global\lmnVerzalkeZidu = \fontcharht\font`H\relax}%
  \sbox{\lmnSkatlaNaslova}{%
    \color{lmnBarvaNaslova}\lmnUniverzaSans\bfseries
    \fontsize{\lmnStopnjaNaslovnice}{\lmnStopnjaNaslovnice}\selectfont
    \global\lmnVerzalkeNaslova = \fontcharht\font`H\relax
    \lmnNaslovNaPlatnici}%
  \sbox{\lmnSkatlaAvtorjev}{%
    \color{lmnBarvaNaslova}\lmnUniverzaSans\fontsize{13}{\lmnEnota}\selectfont
    \renewcommand{\and}{\quad\textbar\quad}\@author}%
  % Pas je najmanjse celo stevilo vrstic, pri katerem je razdalja od
  % osnovnice zidu nad pasom do verzalk naslova vsaj \lmnZracnostPasuZgoraj
  % in razdalja od osnovnice avtorjev do verzalk zidu pod pasom vsaj
  % \lmnZracnostPasuSpodaj.  Ostanek zaokrozitve razdelimo na pol.
  \lmnVrsticPasu = \fpeval{ceil((\lmnVerzalkeNaslova + \lmnRazmikNaslovnice
    + \lmnVerzalkeZidu + \lmnZracnostPasuZgoraj + \lmnZracnostPasuSpodaj)
    / \lmnRazmikZiduNaPlosci)}\relax
  \setlength{\lmnOdmikNaslova}{\dimexpr \lmnZracnostPasuZgoraj +
    (\lmnRazmikZiduNaPlosci * \lmnVrsticPasu
     - \lmnVerzalkeNaslova - \lmnRazmikNaslovnice - \lmnVerzalkeZidu
     - \lmnZracnostPasuZgoraj - \lmnZracnostPasuSpodaj) / 2 \relax}%
  \lmnZadnjaVrsticaNadPasom = \fpeval{round((\lmnPolozajNaslova * \paperheight
    - \lmnRobNaslovnice - \lmnRezZidu - \lmnVrsticPasu * \lmnRazmikZiduNaPlosci / 2)
    / \lmnRazmikZiduNaPlosci)}\relax
  \setlength{\lmnOsnovnicaNaslova}{\dimexpr
    \lmnRezZidu + \lmnRazmikZiduNaPlosci * \lmnZadnjaVrsticaNadPasom
    + \lmnOdmikNaslova + \lmnVerzalkeNaslova \relax}%
  \setbox\lmnZidSpodaj = \vbox{%
    \hsize = \dimexpr \paperwidth - 2\lmnRobNaslovnice + 2\lmnPorezZidu \relax
    \fontsize{\lmnStopnjaZidu}{\lmnRazmikZiduNaPlosci}\selectfont
    \parindent = 0pt
    \lineskiplimit = -\maxdimen
    \relpenalty = 0
    \binoppenalty = 0
    \lmnZid\par}%
  \vbadness = 10000
  \splitmaxdepth = \maxdimen
  \splittopskip = \lmnRazmikZiduNaPlosci
  \setbox\lmnZidZgoraj = \vsplit\lmnZidSpodaj to
    \dimexpr \lmnRazmikZiduNaPlosci * \numexpr \lmnZadnjaVrsticaNadPasom + 1 \relax \relax
  \setbox\lmnZidZgoraj = \vbox{\unvbox\lmnZidZgoraj}%
  \noindent\begin{tikzpicture}[remember picture, overlay]
    \coordinate (lmnPloscaZL) at
      ([xshift = \lmnRobNaslovnice, yshift = -\lmnRobNaslovnice] current page.north west);
    \coordinate (lmnPloscaSD) at
      ([xshift = -\lmnRobNaslovnice, yshift = \lmnRobNaslovnice] current page.south east);
    \fill[lmnPodlagaZidu] (lmnPloscaZL) rectangle (lmnPloscaSD);
    \begin{scope}
      \clip (lmnPloscaZL) rectangle (lmnPloscaSD);
      \node[anchor = base west, inner sep = 0pt, text = lmnBarvaZidu]
        at ([xshift = -\lmnPorezZidu,
             yshift = -\lmnRezZidu
                      - \the\lmnZadnjaVrsticaNadPasom * \lmnRazmikZiduNaPlosci]
            lmnPloscaZL)
        {\usebox{\lmnZidZgoraj}};
      % Prva osnovnica spodnjega dela je \splittopskip pod njegovim vrhom.
      \node[anchor = north west, inner sep = 0pt, text = lmnBarvaZidu]
        at ([xshift = -\lmnPorezZidu,
             yshift = -\lmnRezZidu
                      - (\the\lmnZadnjaVrsticaNadPasom + \the\lmnVrsticPasu - 1)
                        * \lmnRazmikZiduNaPlosci]
            lmnPloscaZL)
        {\usebox{\lmnZidSpodaj}};
    \end{scope}
    \node[anchor = base west, inner sep = 0pt]
      at ([xshift = 1in + \hoffset + \oddsidemargin - \lmnRobNaslovnice,
           yshift = -\lmnOsnovnicaNaslova]
          lmnPloscaZL)
      {\usebox{\lmnSkatlaNaslova}};
    \node[anchor = base west, inner sep = 0pt]
      at ([xshift = 1in + \hoffset + \oddsidemargin - \lmnRobNaslovnice,
           yshift = -\lmnOsnovnicaNaslova - \lmnRazmikNaslovnice]
          lmnPloscaZL)
      {\usebox{\lmnSkatlaAvtorjev}};
  \end{tikzpicture}%
  \end{titlepage}%
  \lmnHrbtnaStran
}

